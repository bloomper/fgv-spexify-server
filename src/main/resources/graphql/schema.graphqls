scalar Instant
scalar Void

type Query {
    "Anyone logged in. The caller and their roles."
    me: Me!
    "USER. The start page texts and the limits for app passwords."
    settings: Settings!
    "USER. Albums by year, newest first, or in the filter's order. Unpublished ones only for EDITOR, and only when asked for."
    albums(filter: AlbumFilter): [Album!]!
    "USER. Listed albums ranked by everyone: by weighted average rating, likes or plays of their tracks. Albums without any are left out. The filter's sort and liked are ignored."
    topAlbums(by: TopBy = RATED, filter: AlbumFilter, limit: Int = 20): [Album!]!
    "USER. Listed tracks of the listed albums the filter lists, ranked by everyone. Tracks without any are left out."
    topTracks(by: TopBy = RATED, filter: AlbumFilter, limit: Int = 20): [Track!]!
    "USER. An album; unpublished or trashed ones only for EDITOR."
    album(id: ID!): Album
    "USER. A track the caller may play: listed ones, any for EDITOR; null otherwise."
    track(id: ID!): Track
    "USER. The most recently published albums."
    recentAlbums(limit: Int = 12): [Album!]!
    "USER. The album kinds, in order; the first is the default."
    albumKinds: [AlbumKind!]!
    "USER. The album media (LP, EP, CD, digital …), in order."
    albumMedia: [AlbumMedium!]!
    "USER. Spexipedia's number kinds (overture, finale…) that listed tracks are recordings of, in Spexipedia's order; empty when Spexipedia is unavailable."
    numberKinds: [NumberKind!]!
    "USER. Listed albums about a spex whose premiere was on today's date in an earlier year, oldest first; empty when Spexipedia is unavailable."
    thisDayAlbums: [Album!]!
    "USER. Published albums by Navidrome's ids, in the given order, for what the caller played; unknown ones are left out."
    albumsByNavidromeIds(ids: [String!]!): [Album!]!
    "USER. The categories of the published albums."
    categories: [Category!]!
    "USER. The years of the published albums, newest first."
    years: [Int!]!
    "USER. Albums and tracks whose titles, performers, melodies or lyrics match."
    search(q: String!): SearchResult!
    "USER. Collections with a listed album, by title; every collection for EDITOR."
    collections: [Collection!]!
    "USER. A collection with a listed album; any collection for EDITOR."
    collection(id: ID!): Collection
    "USER. The names listed tracks are credited to, by name, with how many tracks each."
    credits(kind: CreditKind!): [Credit!]!
    "USER. The listed tracks credited to a name, newest album first. The name is matched without regard to case."
    creditTracks(kind: CreditKind!, name: String!): [Track!]!
    "USER. Listed tracks to play like a radio station. From a track: the track first, then tracks sharing its melody, original artist, performers, authors or spex. From an album: such tracks from other albums. Without either: listed tracks at random."
    radio(trackId: ID, albumId: ID, limit: Int = 50): [Track!]!
    "EDITOR. Spex in Spexipedia, retired ones left out, matching a title or year, for linking an album: each original, then its revivals, newest original first. An original is included when only a revival matches."
    spexSearch(q: String!): [Spex!]!
    "EDITOR. The numbers of a spex in Spexipedia, by act and position, for linking tracks."
    spexNumbers(spexId: ID!): [SpexNumber!]!
    "SPEXIPEDIA. The published albums about the spex (or revivals of them), and the published tracks of the numbers. At most 500 ids each."
    spexipediaLinks(spexIds: [ID!]!, numberIds: [ID!]!): SpexipediaLinks!
    "SPEXIPEDIA. The discography of the spex (or revivals of them): published albums with every published track, also those without audio, and signed links to the covers. At most 500 ids."
    spexipediaDiscography(spexIds: [ID!]!): [DiscographyAlbum!]!
    "USER. The caller's app passwords that are not revoked."
    appPasswords: [AppPassword!]!
    "USER. The caller's API keys that are not revoked."
    apiKeys: [ApiKey!]!
    "ADMIN. Everyone who has used Spexify, with how many app passwords and keys they have."
    users: [UserSummary!]!
    "EDITOR. Trashed albums and tracks."
    trash: Trash!
    "EDITOR. Navidrome's state and the last scan."
    libraryStatus: LibraryStatus!
    "EDITOR. The audit log, newest first: the caller's own changes, or everyone's for ADMIN, narrowed by the filter."
    auditLog(page: Int = 0, size: Int = 50, filter: AuditFilter): AuditPage!
    "EDITOR. Who made the changes in the audit log the caller sees, with their latest names; only the caller unless ADMIN."
    auditActors: [AuditActor!]!
    "SPEXFLIX or EDITOR. The published tracks of the published albums of the spex and, for originals, their revivals, for linking chapters."
    spexTracks(spexIds: [ID!]!): [TrackRef!]!
    "USER. Published tracks by Navidrome's ids, in the given order, for stars and playlists; unknown ones are left out."
    tracksByNavidromeIds(ids: [String!]!): [Track!]!
    "SPEXFLIX or USER. Published tracks by id; unknown and unpublished ones are left out."
    tracksByIds(ids: [ID!]!): [TrackRef!]!
    "ADMIN. The scheduled maintenance jobs, with their schedules and how their latest runs went."
    maintenanceJobs: [MaintenanceJobStatus!]!
    "ADMIN. How the copy of Spexipedia's base data follows its change feed, and the latest changes that were skipped."
    spexipediaSync: SpexipediaSyncStatus!
}

type Mutation {
    "EDITOR. New albums start unpublished."
    albumCreate(input: AlbumInput!): Album!
    "EDITOR."
    albumUpdate(id: ID!, input: AlbumInput!): Album!
    "EDITOR. Publishing puts the album's published tracks into Navidrome."
    albumPublish(id: ID!, published: Boolean!): Album!
    "EDITOR. Hides the album everywhere except the trash."
    albumTrash(id: ID!): Album!
    "EDITOR."
    albumRestore(id: ID!): Album!
    "ADMIN. Only a trashed album; deletes its files."
    albumDelete(id: ID!): Void
    "EDITOR. The spex poster is shown instead."
    albumCoverRemove(id: ID!): Album!
    "EDITOR. Removes the back of the sleeve (uploaded at /api/albums/{id}/back-cover)."
    albumBackCoverRemove(id: ID!): Album!
    "EDITOR. Links the track to a number in Spexipedia of one of its album's spex; null unlinks it."
    trackSetNumber(id: ID!, numberId: ID): Track!
    "EDITOR. Numbers the album's tracks in the given order, per disc."
    tracksReorder(albumId: ID!, trackIds: [ID!]!): Album!
    "EDITOR. A track from a finished upload; tags in the file pre-fill its fields."
    trackCreate(albumId: ID!, uploadId: String!): Track!
    "EDITOR. The melody, lyrics author and arranger are taken only for a track without a Spexipedia number."
    trackUpdate(id: ID!, input: TrackInput!): Track!
    "EDITOR. A track without audio, for the discography of a record that is not digitised yet; its audio is uploaded later with trackReplaceAudio."
    trackAdd(albumId: ID!, input: TrackInput!): Track!
    "EDITOR. Saves the lyrics alone and keeps the earlier version in the history. Fails with CONFLICT when someone saved them after baseRevisionId (null: when there were no saved versions)."
    trackLyricsUpdate(id: ID!, lyrics: String, synced: Boolean!, baseRevisionId: ID): Track!
    "EDITOR. Restores a saved version of the lyrics, as a new version."
    trackLyricsRestore(id: ID!, revisionId: ID!): Track!
    "EDITOR, with access to Spexarkivet. Saves a map made by hand for a MusicXML file of the track's sheet music; it wins over the automatic one. Fails with CONFLICT when the map was saved by someone else after version (null for a new one)."
    scoreSyncSave(trackId: ID!, fileId: ID!, input: ScoreSyncInput!, version: Float): ScoreSync!
    "EDITOR. Removes the map made by hand, so that the automatic one is used; returns whether there was one."
    scoreSyncDelete(trackId: ID!, fileId: ID!): Boolean!
    "EDITOR, with access to Spexarkivet. Aligns the recording with the score in the background; the map is PENDING until it is DONE or FAILED."
    scoreAlign(trackId: ID!, fileId: ID!): ScoreSync!
    "EDITOR. Replaces the audio file with a finished upload."
    trackReplaceAudio(id: ID!, uploadId: String!): Track!
    "EDITOR."
    trackPublish(id: ID!, published: Boolean!): Track!
    "EDITOR."
    trackTrash(id: ID!): Track!
    "EDITOR."
    trackRestore(id: ID!): Track!
    "ADMIN. Only a trashed track; deletes its file."
    trackDelete(id: ID!): Void
    "ADMIN. Deletes every trashed album and track with their files."
    trashEmpty: Void
    "USER. The password is shown once."
    appPasswordCreate(name: String!): AppPasswordCreated!
    "USER. One of the caller's own."
    appPasswordRevoke(id: ID!): Void
    "USER. The key is shown once."
    apiKeyCreate(name: String!): ApiKeyCreated!
    "USER. One of the caller's own."
    apiKeyRevoke(id: ID!): Void
    "ADMIN. Revokes all of a user's app passwords and API keys."
    userCredentialsRevoke(userId: ID!): Void
    "ADMIN. Lifts a lock-out after failed logins."
    userUnlock(userId: ID!): Void
    "ADMIN. Asks Navidrome to scan the music folder."
    libraryRescan: Void
    "ADMIN. Added last."
    albumKindCreate(input: AlbumKindInput!): AlbumKind!
    "ADMIN."
    albumKindUpdate(id: ID!, input: AlbumKindInput!): AlbumKind!
    "ADMIN. Every kind, in the new order; the first becomes the default."
    albumKindsReorder(ids: [ID!]!): [AlbumKind!]!
    "ADMIN. Only a kind no album uses, trashed ones included, and not the last one."
    albumKindDelete(id: ID!): Void
    "ADMIN. Added last."
    albumMediumCreate(input: AlbumMediumInput!): AlbumMedium!
    "ADMIN."
    albumMediumUpdate(id: ID!, input: AlbumMediumInput!): AlbumMedium!
    "ADMIN. Every medium, in the new order."
    albumMediaReorder(ids: [ID!]!): [AlbumMedium!]!
    "ADMIN. Only a medium no album uses, trashed ones included."
    albumMediumDelete(id: ID!): Void
    "EDITOR. The albums are kept in the given order."
    collectionCreate(input: CollectionInput!): Collection!
    "EDITOR. Replaces the title, description and albums."
    collectionUpdate(id: ID!, input: CollectionInput!): Collection!
    "ADMIN. The albums stay."
    collectionDelete(id: ID!): Void
    "ADMIN."
    settingsUpdate(input: SettingsInput!): Settings!
    "ADMIN. Starts the job in the background, as its schedule would. False when it is already running."
    maintenanceJobRun(job: MaintenanceJob!): Boolean!
}

type Me {
    username: String!
    displayName: String
    roles: [String!]!
    "Whether the caller also has access to Spexflix, for showing links there."
    spexflixUser: Boolean!
    "Whether the caller also has access to Spexarkivet, for showing sheet music and links there."
    archiveUser: Boolean!
}

type Settings {
    welcomeSv: String
    welcomeEn: String
    appPasswordExpiryMonths: Int!
    lockoutAttempts: Int!
    lockoutMinutes: Int!
}

input SettingsInput {
    welcomeSv: String
    welcomeEn: String
    appPasswordExpiryMonths: Int!
    lockoutAttempts: Int!
    lockoutMinutes: Int!
}

"What an album is a recording of, e.g. a show or a studio recording. Configured by admins."
type AlbumKind {
    id: ID!
    nameSv: String!
    nameEn: String!
    "Other spellings the import recognises."
    aliases: [String!]!
    position: Int!
    "The first by position: used for new albums and not shown as a badge."
    isDefault: Boolean!
    "Albums of this kind, trashed ones included."
    albumCount: Int!
}

"What a released album came out on, e.g. LP, EP, CD or digital, for the discography. Configured by admins."
type AlbumMedium {
    id: ID!
    nameSv: String!
    nameEn: String!
    "Other spellings the import recognises."
    aliases: [String!]!
    position: Int!
    "Albums on this medium, trashed ones included."
    albumCount: Int!
}

input AlbumMediumInput {
    nameSv: String!
    nameEn: String!
    "Null leaves them as they are."
    aliases: [String!]
}

input AlbumKindInput {
    nameSv: String!
    nameEn: String!
    "Null leaves them as they are."
    aliases: [String!]
}

input AlbumFilter {
    "The main spex's category."
    categoryId: ID
    year: Int
    "Albums about the spex or, when it is an original, one of its revivals."
    spexId: ID
    "EDITOR only."
    includeUnpublished: Boolean
    kindId: ID
    "Albums from this year on."
    fromYear: Int
    "Albums up to and including this year."
    toYear: Int
    "Only albums the caller likes."
    liked: Boolean
    sort: AlbumSort
}

"How to order albums. Ties keep the default order: newest year first, then title."
enum AlbumSort {
    "Newest year first; the default."
    YEAR_DESC
    YEAR_ASC
    TITLE
    "Most recently published first."
    PUBLISHED
    "Highest weighted average rating first; unrated albums last."
    RATING
    "Most liked first."
    LIKES
    "Most played by everyone first."
    PLAYS
}

"""
What a top list ranks by. Navidrome keeps ratings, likes and plays per user; Spexify mirrors them as the Subsonic
gateway passes them on, and copies them every night (LISTENING_SYNC).
"""
enum TopBy {
    "Everyone's ratings, as an average weighed against two votes of the mean of all ratings, so that one 5 does not top the list."
    RATED
    "How many like it."
    LIKED
    "How often everyone played it; an album counts its tracks' plays."
    PLAYED
}

input AlbumInput {
    "Spex in Spexipedia, the main one first, e.g. several for a compilation. Empty when the album is not about any spex, e.g. a jubilee recording."
    spexIds: [ID!]! = []
    "Defaults to the main spex's title; required without a spex."
    title: String
    "Defaults to the main spex's year."
    year: Int
    "An album kind; defaults to the first one for a new album and to the current one for an existing album."
    kindId: ID
    description: String
    "For a released record, e.g. 'CEP 019'."
    catalogueNumber: String
    "An album medium; none for an album that was never released."
    mediumId: ID
    "As precise as known: '1987', '1987-04' or '1987-04-12'."
    released: String
    recorded: String
    "Free text, as on the record."
    conductor: String
}

input TrackInput {
    discNumber: Int!
    trackNumber: Int!
    title: String!
    performers: String
    melody: String
    lyricsAuthor: String
    arranger: String
    lyrics: String
    "Whether the lyrics are LRC with timestamps."
    lyricsSynced: Boolean!
    "The side of a record, e.g. 'A'."
    side: String
}

type Category {
    id: ID!
    name: String!
    albumCount: Int!
}

type Spex {
    id: ID!
    title: String
    year: Int
    revival: Boolean!
    "The original, for a revival."
    parentId: ID
    categoryName: String
}

type AlbumSpex {
    id: ID!
    title: String
    year: Int
    revival: Boolean
    "The original, for a revival; null until the nightly refresh for spex linked before Spexify kept it."
    parentId: ID
    "The original spex: the parent of a revival, else the spex itself. Revivals share it with their original."
    familyId: ID!
    categoryId: ID
    categoryName: String
}

type Album {
    id: ID!
    title: String!
    year: Int
    kind: AlbumKind!
    description: String
    "The spex the album is about, the main one first; empty when it is not about any spex."
    spex: [AlbumSpex!]!
    "Whether the album has its own cover; otherwise the main spex's poster is used."
    hasCover: Boolean!
    "Whether the album has the back of its sleeve (at /api/albums/{id}/back-cover)."
    hasBackCover: Boolean!
    "The discography: the catalogue number of a released record, e.g. 'CEP 019'."
    catalogueNumber: String
    medium: AlbumMedium
    "As precise as known: '1987', '1987-04' or '1987-04-12'."
    released: String
    recorded: String
    "Free text, as on the record."
    conductor: String
    published: Boolean!
    publishedAt: Instant
    trashedAt: Instant
    navidromeId: String
    "Listed tracks for listeners; every track not in the trash for EDITOR."
    tracks: [Track!]!
    trackCount: Int!
    durationMs: Float!
    "Everyone's average rating, or null when nobody rated it."
    averageRating: Float
    ratingCount: Int!
    "How many like it."
    likeCount: Int!
    "How often everyone played its tracks."
    totalPlays: Int!
    "The collections the album is in, by title."
    collections: [CollectionRef!]!
    createdAt: Instant!
    lastModifiedAt: Instant
}

type Track {
    id: ID!
    albumId: ID!
    albumTitle: String!
    discNumber: Int!
    trackNumber: Int!
    "The side of a record, e.g. 'A'."
    side: String
    title: String!
    performers: String
    "For a track that is a recording of a number, the number's original song from Spexipedia."
    melody: String
    "For a track that is a recording of a number, the number's lyrics credits from Spexipedia."
    lyricsAuthor: String
    "For a track that is a recording of a number, the number's arrangement credits from Spexipedia."
    arranger: String
    "Whether the melody and credits are the number's, from Spexipedia, and edited there."
    creditsFromNumber: Boolean!
    "Every credit of the number the track is a recording of, by kind, from Spexipedia; empty for other tracks and when Spexipedia is unavailable."
    credits: [TrackCredit!]!
    lyrics: String
    lyricsSynced: Boolean!
    "Whether the track has its audio; one without it is an entry of the discography only."
    hasAudio: Boolean!
    "Null for a track without audio."
    format: String
    fileSize: Float!
    durationMs: Float!
    bitrate: Int
    published: Boolean!
    "Published, in a published album, and not in the trash: in Navidrome."
    listed: Boolean!
    trashedAt: Instant
    navidromeId: String
    fileMissing: Boolean!
    "ReplayGain 2.0 values from the measured loudness; null until measured."
    replayGain: ReplayGain
    "The number in Spexipedia the track is a recording of."
    numberId: ID
    "The number's title, as copied from Spexipedia."
    numberTitle: String
    "The number's kind in Spexipedia; null when the track is not linked, the number has none or Spexipedia is unavailable."
    numberKind: NumberKind
    "The number on its spex's page in Spexipedia."
    spexipediaUrl: String
    "Published Spexflix videos with a chapter linked to the track; empty when Spexflix is unavailable."
    videoLinks: [VideoLink!]!
    "Sheet music in Spexarkivet: the arrangement of the number the track is a recording of, with its open versions. Only for users with access to the archive; null for others, without a number or arrangement, or when the archive is unavailable."
    sheetMusic: SheetMusic
    "Where in each MusicXML score of the sheet music each moment of the recording is, for the cursor that follows the notes. USER sees each score's map that is done, the one made by hand before the automatic one; EDITOR sees every map. Only for users with access to the archive."
    scoreSyncs: [ScoreSync!]!
    "The singer labels at the start of lyric lines, such as 'Ph:' or 'Ph/Pa:', with the names of the spex's characters in Spexipedia they stand for. Choir labels such as 'Kör' are given as they are; labels that name no one, or more than one, are left out."
    singers: [SingerLabel!]!
    "EDITOR. Every saved version of the lyrics, newest first; empty for others."
    lyricsRevisions: [LyricsRevision!]!
    "EDITOR. The loudest sample in each of points equal slices of the recording, from 0 to 1, for the lyrics editor. At most 4000 points."
    waveform(points: Int = 1000): [Float!]!
    "Everyone's average rating, or null when nobody rated it."
    averageRating: Float
    ratingCount: Int!
    "How many like it."
    likeCount: Int!
    "How often everyone played it."
    totalPlays: Int!
}

"A credit of the number a track is a recording of: the credit kind and the person, as Spexipedia shows them."
type TrackCredit {
    kindId: ID!
    kindNameSv: String!
    kindNameEn: String!
    "The spexare in Spexregister; null for someone outside FGV."
    spexareId: ID
    name: String!
}

"""
A kind of number in Spexipedia, e.g. an overture or a finale. Admins keep them in Spexipedia; each track keeps its
number's kind, refreshed at night.
"""
type NumberKind {
    id: ID!
    nameSv: String!
    nameEn: String!
    "How many listed tracks are recordings of numbers of this kind."
    trackCount: Int!
    "Listed tracks of numbers of this kind, newest album first; at most 100."
    tracks(limit: Int = 20): [Track!]!
}

"A number (one song) of a spex in Spexipedia."
type SpexNumber {
    id: ID!
    spexId: ID
    act: Int!
    position: Int!
    title: String!
}

"An album of the discography, for Spexipedia's spex pages."
type DiscographyAlbum {
    id: ID!
    title: String!
    year: Int
    kindNameSv: String!
    kindNameEn: String!
    mediumNameSv: String
    mediumNameEn: String
    catalogueNumber: String
    released: String
    recorded: String
    conductor: String
    "The spex asked for that the album is about."
    spexId: ID
    "A signed link to the front cover, valid for some hours; null without one."
    coverUrl: String
    backCoverUrl: String
    tracks: [DiscographyTrack!]!
}

type DiscographyTrack {
    id: ID!
    side: String
    discNumber: Int!
    trackNumber: Int!
    title: String!
    "The number in Spexipedia the track is a recording of."
    numberId: ID
    "Whether it can be listened to in Spexify."
    hasAudio: Boolean!
}

type SpexipediaLinks {
    albums: [SpexipediaAlbumLink!]!
    tracks: [SpexipediaTrackLink!]!
}

type SpexipediaAlbumLink {
    id: ID!
    title: String!
    "The spex asked for that the album is about."
    spexId: ID
}

type SpexipediaTrackLink {
    id: ID!
    title: String!
    numberId: ID
    albumId: ID!
}

"An arrangement in Spexarkivet, with the versions every reader may open."
type SheetMusic {
    arrangementId: ID!
    "The arrangement's page in Spexarkivet."
    archiveUrl: String
    "The recommended version first, then the newest."
    versions: [SheetMusicVersion!]!
}

type SheetMusicVersion {
    id: ID!
    label: String!
    arranger: String
    recommended: Boolean!
    "The concert key, in Swedish, e.g. Fiss-moll."
    key: String
    tempo: String
    "In the archive's order. Open one at /api/tracks/{trackId}/sheet-music/{fileId}."
    files: [SheetMusicFile!]!
}

type SheetMusicFile {
    id: ID!
    title: String!
    "The name it was uploaded with."
    name: String!
    extension: String!
    contentType: String!
    size: Float!
    pages: Int
    "Its role in the archive, e.g. Partitur or Stämma."
    roleSv: String!
    roleEn: String!
    instrumentsSv: [String!]!
    instrumentsEn: [String!]!
    "Which desk or voice a part is, e.g. 1 or 1–2."
    desk: String
    kind: SheetFileKind!
}

"What the web can do with a sheet music file."
enum SheetFileKind {
    "Read it."
    PDF
    "Draw it as notes, follow the recording with a cursor, or play it."
    MUSIC_XML
    "Play it."
    MIDI
    "Download it."
    OTHER
}

"Where in a MusicXML score each moment of a recording is."
type ScoreSync {
    "The score's file in Spexarkivet."
    fileId: ID!
    method: ScoreSyncMethod!
    status: ScoreSyncStatus!
    "In the order of the recording, seconds strictly increasing; empty unless DONE."
    points: [SyncPoint!]!
    "How the recording walks through the written score, when it differs from the repeat signs; maps made by hand only."
    jumps: [SyncJump!]!
    "From 0 (useless) to 1; 1 for maps made by hand."
    quality: Float
    "Why it FAILED."
    error: String
    "Whether the recording was replaced since the map was made."
    stale: Boolean!
    updatedAt: Instant
    "For scoreSyncSave, which refuses to overwrite a newer map."
    version: Float
}

type SyncPoint {
    "Into the recording."
    seconds: Float!
    "The measure's place in the written score, from 0."
    measure: Int!
    "Quarter notes from the measure's start."
    beat: Float!
}

"After measure after is played (its nth play, from 0; the first unused jump when null), the recording goes on at measure to."
type SyncJump {
    after: Int!
    to: Int!
    nth: Int
}

input ScoreSyncInput {
    "At most 5000, seconds strictly increasing."
    points: [SyncPointInput!]!
    jumps: [SyncJumpInput!]
}

input SyncPointInput {
    seconds: Float!
    measure: Int!
    beat: Float!
}

input SyncJumpInput {
    after: Int!
    to: Int!
    nth: Int
}

enum ScoreSyncMethod {
    "Made by an editor; wins over the automatic one."
    MANUAL
    "Found by aligning the recording with the score."
    AUTOMATIC
}

enum ScoreSyncStatus {
    PENDING
    RUNNING
    DONE
    FAILED
}

type SingerLabel {
    "As written in the lyrics, e.g. Ph/Pa."
    label: String!
    "The names it stands for, e.g. Philip & Pamela."
    name: String!
}

"A saved version of a track's lyrics."
type LyricsRevision {
    id: ID!
    lyrics: String
    synced: Boolean!
    createdAt: Instant!
    "Who saved it; null for the lyrics from before the first change in Spexify (an upload or an import)."
    createdBy: String
}

type VideoLink {
    videoId: ID!
    videoTitle: String!
    chapterTitle: String!
    startSeconds: Int!
}

"ReplayGain 2.0, aiming at -18 LUFS: gains in dB, peaks as linear amplitudes where 1.0 is full scale."
type ReplayGain {
    trackGain: Float!
    trackPeak: Float!
    "The album's listed tracks together; null for tracks that are not listed."
    albumGain: Float
    albumPeak: Float
}

"Who or what a track is credited to. Names are split on commas, semicolons, slashes and ampersands."
enum CreditKind {
    PERFORMER
    "The original song, e.g. Dancing Queen (ABBA)."
    MELODY
    "The artist in parentheses at the end of the melody, e.g. ABBA."
    ORIGINAL_ARTIST
    LYRICS_AUTHOR
    ARRANGER
}

type Credit {
    name: String!
    trackCount: Int!
}

type TrackRef {
    id: ID!
    title: String!
    discNumber: Int!
    trackNumber: Int!
    albumId: ID!
    albumTitle: String!
    "The album's main spex."
    spexId: ID
}

type SearchResult {
    albums: [Album!]!
    tracks: [Track!]!
}

type AppPassword {
    id: ID!
    name: String!
    createdAt: Instant!
    lastUsedAt: Instant
    expiresAt: Instant!
    expired: Boolean!
}

type AppPasswordCreated {
    appPassword: AppPassword!
    "Shown once."
    password: String!
    "The username to type into the app."
    username: String!
}

type ApiKey {
    id: ID!
    name: String!
    createdAt: Instant!
    lastUsedAt: Instant
}

type ApiKeyCreated {
    apiKey: ApiKey!
    "Shown once."
    key: String!
}

type UserSummary {
    id: ID!
    username: String!
    displayName: String
    lastSeenAt: Instant!
    appPasswordCount: Int!
    apiKeyCount: Int!
    locked: Boolean!
}

type Trash {
    albums: [Album!]!
    "Trashed tracks of albums that are not trashed themselves."
    tracks: [Track!]!
}

type LibraryStatus {
    navidromeAvailable: Boolean!
    scanning: Boolean!
    scanPending: Boolean!
    lastScanAt: Instant
    lastScanError: String
    trackCount: Int!
    listedTrackCount: Int!
}

type AuditPage {
    entries: [AuditLogEntry!]!
    totalCount: Int!
    page: Int!
    size: Int!
}

type AuditLogEntry {
    id: ID!
    at: Instant!
    "Who made the change, by their subject."
    actorId: String!
    actorName: String
    action: String!
    entityType: String!
    entityId: ID
    summary: String!
}

"""
A scheduled maintenance job: copying the current spex data and the kinds of linked numbers from Spexipedia in full (SPEX_REFRESH; other changes also arrive from its change feed within minutes), removing uploads that
were never used (UPLOAD_CLEANUP), measuring the loudness of tracks that have none yet, for ReplayGain
(LOUDNESS_SCAN), copying everyone's ratings, likes and plays from Navidrome, for averages and top lists
(LISTENING_SYNC), and aligning recordings with the MusicXML scores of their sheet music in Spexarkivet that have no
automatic map for that score and recording yet, so that the cursor follows the notes (SCORE_ALIGN).
"""
enum MaintenanceJob {
    SPEX_REFRESH
    UPLOAD_CLEANUP
    LOUDNESS_SCAN
    LISTENING_SYNC
    SCORE_ALIGN
}

"A maintenance job and how its latest run went. Runs are remembered until the server restarts."
type MaintenanceJobStatus {
    job: MaintenanceJob!
    "The job's cron expression, in the server's time zone, or null when it is not scheduled."
    schedule: String
    running: Boolean!
    "When the latest run started, or null when it has not run since the server started."
    lastStartedAt: Instant
    lastFinishedAt: Instant
    "Whether the latest run finished without an error; null while it runs."
    lastSucceeded: Boolean
}

"What to show of the audit log; every field is optional."
input AuditFilter {
    "What was changed, e.g. ALBUM or VIDEO."
    entityType: String
    "CREATE, UPDATE, DELETE and so on."
    action: String
    "Who made the change; only ADMIN sees others' changes."
    actorId: String
    "Changes from this instant on."
    from: Instant
    "Changes before this instant."
    to: Instant
    "Text the summary contains."
    q: String
    "One record's changes."
    entityId: ID
}

type AuditActor {
    id: String!
    name: String
}

"Albums grouped in an order of their own, e.g. a spex's recordings over the years."
type Collection {
    id: ID!
    title: String!
    description: String
    "Listed albums for listeners; every album not in the trash for EDITOR."
    albums: [Album!]!
    createdAt: Instant!
    lastModifiedAt: Instant
}

type CollectionRef {
    id: ID!
    title: String!
}

input CollectionInput {
    title: String!
    description: String
    albumIds: [ID!]!
}

# The import API (spec 5.6; Spexipedia's docs/content-import.md, section 4) ---------------------------------------------
# IMPORT only. Files are uploaded first to PUT /api/import/files/{sha256} and referred to by their hash. Everything
# arrives unpublished.

extend type Mutation {
    "IMPORT. Imports albums and tracks: new source keys create, known ones update what they made unless an editor has changed it since. With dryRun nothing is kept. At most 500 records."
    importBatch(input: ImportBatchInput!, dryRun: Boolean! = false): ImportResult!
    "IMPORT. Removes what was imported under the source prefix and is still unpublished and unchanged; returns how many."
    importForget(sourcePrefix: String!): Int!
}

input ImportBatchInput {
    "Whether album kinds nobody knows become new kinds, instead of failing the record."
    createMissingKinds: Boolean = false
    albums: [ImportAlbumInput!]
    tracks: [ImportTrackInput!]
}

input ImportFileRefInput {
    sha256: String!
    "The file's name, for its type."
    name: String
}

"An album of spex in Spexipedia, of an album kind by name or alias, with a cover image."
input ImportAlbumInput {
    sourceKey: String!
    spexIds: [ID!]
    kind: String
    title: String
    year: Int
    description: String
    cover: ImportFileRefInput
    "The discography: the catalogue number of a released record."
    catalogueNumber: String
    "An album medium by name or alias (LP, EP, CD …)."
    medium: String
    "As precise as known: '1987', '1987-04' or '1987-04-12'."
    released: String
    recorded: String
    conductor: String
    backCover: ImportFileRefInput
}

"A track of an album imported with albumSourceKey, with its audio file when there is one; WAV and AIFF become FLAC. numberId links it to a number in Spexipedia, which then gives the melody and credits."
input ImportTrackInput {
    sourceKey: String!
    albumSourceKey: String!
    discNumber: Int
    trackNumber: Int
    title: String!
    numberId: ID
    performers: String
    melody: String
    lyricsAuthor: String
    arranger: String
    lyrics: String
    lyricsSynced: Boolean
    "Without a file the track is an entry of the discography only, until its audio comes."
    file: ImportFileRefInput
    "The side of a record, e.g. 'A'."
    side: String
}

type ImportResult {
    dryRun: Boolean!
    items: [ImportItem!]!
    created: Int!
    updated: Int!
    unchanged: Int!
    kept: Int!
    failed: Int!
}

type ImportItem {
    kind: String!
    sourceKey: String!
    id: ID
    outcome: ImportOutcome!
    message: String
    warnings: [String!]!
}

enum ImportOutcome {
    CREATED
    UPDATED
    UNCHANGED
    "An editor changed or removed the record since it was imported, so the import left it alone."
    KEPT
    FAILED
}

"How the copy of Spexipedia's base data follows its change feed."
type SpexipediaSyncStatus {
    "When the feed was last asked, or null when it never was."
    lastPulledAt: Instant
    "When every change asked for was last applied."
    lastSuccess: Instant
    "Why the latest pull failed; null when it did not."
    lastError: String
    "The latest changes that could not be applied and were left out, newest first, at most 50."
    skipped: [SpexipediaSyncSkipped!]!
}

"""
A change from Spexipedia that failed five pulls in a row and was left out, so that the changes after it are not held up.
The copy lacks it until the record is changed again in Spexipedia.
"""
type SpexipediaSyncSkipped {
    "Its place in the feed."
    sequence: String!
    "SPEX_CATEGORY, SPEX, TASK_CATEGORY, TASK, CHARACTER or NUMBER."
    kind: String!
    "The record's id in Spexipedia."
    id: ID!
    "UPSERT, RETIRE or MERGE."
    change: String!
    error: String!
    skippedAt: Instant!
}
